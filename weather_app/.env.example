# -----------------------------------------------------------------------------
# Modele de configuration - weather_app
# -----------------------------------------------------------------------------
# 1. Copiez ce fichier en ".env"   ->   copy .env.example .env   (Windows)
#                                       cp .env.example .env     (Linux / macOS)
# 2. Creez un compte gratuit sur https://openweathermap.org/api
# 3. Recuperez votre cle dans "My API keys" et remplacez your_key_here.
#
# ATTENTION : une cle nouvellement creee peut mettre jusqu'a 2 heures avant
# d'etre activee par OpenWeatherMap (l'API repond 401 en attendant).
#
# Le fichier .env reel est ignore par git : ne le committez jamais.
# -----------------------------------------------------------------------------

OPENWEATHER_API_KEY=your_key_here

# URL de base de l'API (ne pas modifier sauf besoin specifique)
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# Unites : metric (Celsius) | imperial (Fahrenheit) | standard (Kelvin)
OPENWEATHER_UNITS=metric

# Langue des descriptions meteo renvoyees par l'API
OPENWEATHER_LANG=fr